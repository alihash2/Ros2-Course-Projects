        </collision>
        <visual name="r03_north_part_w_vis">
          <pose>5.725 -3 1.25 0 0 0</pose>
          <geometry><box><size>2.45 0.2 2.5</size></box></geometry>
          <material><ambient>0.8 0.82 0.85 1</ambient><diffuse>0.8 0.82 0.85 1</diffuse></material>
