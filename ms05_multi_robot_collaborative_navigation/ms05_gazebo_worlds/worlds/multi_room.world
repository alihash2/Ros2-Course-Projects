        <!-- Room crates (two per room, clear of doorways and marker sightlines) -->
        <collision name="r01_crate1_col"><pose>-8.7 7.0 0.25 0 0 0</pose><geometry><box><size>0.6 0.6 0.5</size></box></geometry></collision>
        <visual name="r01_crate1_vis"><pose>-8.7 7.0 0.25 0 0 0</pose><geometry><box><size>0.6 0.6 0.5</size></box></geometry><material><ambient>0.4 0.27 0.12 1</ambient><diffuse>0.4 0.27 0.12 1</diffuse></material></visual>
