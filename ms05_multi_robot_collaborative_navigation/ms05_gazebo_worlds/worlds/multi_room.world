        <!-- Corridor obstacles (loop stays drivable around them) -->
        <collision name="west_pillar_col"><pose>-7.5 0 0.6 0 0 0</pose><geometry><box><size>0.6 0.6 1.2</size></box></geometry></collision>
        <visual name="west_pillar_vis"><pose>-7.5 0 0.6 0 0 0</pose><geometry><box><size>0.6 0.6 1.2</size></box></geometry><material><ambient>0.55 0.55 0.6 1</ambient><diffuse>0.55 0.55 0.6 1</diffuse></material></visual>
