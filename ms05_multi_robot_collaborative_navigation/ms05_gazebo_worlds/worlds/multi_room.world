    <!-- QR wall markers - poses and payloads from markers/qr_markers.yaml -->
    <model name="qr_marker_00">
      <static>true</static>
      <pose>-7.25 7.99 0.30 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>0.45 0.02 0.45</size></box></geometry>
          <material>
            <ambient>1 1 1 1</ambient>
            <diffuse>1 1 1 1</diffuse>
            <specular>0 0 0 1</specular>
            <pbr><metal>
              <albedo_map>../markers/qr_room_01_00.png</albedo_map>
              <roughness>0.9</roughness>
              <metalness>0.0</metalness>
