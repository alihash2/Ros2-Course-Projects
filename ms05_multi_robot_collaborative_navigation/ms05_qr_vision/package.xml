<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ms05_qr_vision</name>
  <version>0.1.0</version>
  <description>Milestone 5: QR code detection from the robot cameras for multi-robot collaborative navigation</description>
  <maintainer email="hashir@todo.todo">hashir</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>rosidl_default_generators</buildtool_depend>

  <build_depend>python3-empy</build_depend>
  <build_depend>python3-lark-parser</build_depend>
  <build_export_depend>python3-empy</build_export_depend>
  <build_export_depend>python3-lark-parser</build_export_depend>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>cv_bridge</depend>

  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>rosidl_default_runtime</exec_depend>

  <member_of_group>rosidl_interface_packages</member_of_group>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
