<?xml version="1.0"?>
<sdf version="1.8">
  <world name="warehouse_world">
    <physics type="ode">
      <real_time_update_rate>1000.0</real_time_update_rate>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <ode>
        <solver>
          <type>quick</type>
          <iters>150</iters>
          <precon_iters>0</precon_iters>
          <sor>1.4</sor>
          <use_dynamic_moi_rescaling>1</use_dynamic_moi_rescaling>
        </solver>
        <constraints>
          <cfm>0.00001</cfm>
          <erp>0.2</erp>
          <contact_max_correcting_vel>2000.0</contact_max_correcting_vel>
          <contact_surface_layer>0.01</contact_surface_layer>
        </constraints>
      </ode>
    </physics>

    <!-- Essential Gazebo Plugins for Simulation -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>

    <!-- Warehouse Overhead Lighting -->
    <light type="directional" name="warehouse_light_1">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 12 0 0 0</pose>
      <diffuse>0.85 0.85 0.85 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.3 0.2 -0.9</direction>
    </light>

    <!-- Concrete Floor Ground Plane -->
    <model name="warehouse_ground">
      <static>true</static>
      <link name="ground_link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>60 60</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>100</mu>
                <mu2>50</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>60 60</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.65 0.65 0.65 1</ambient>
            <diffuse>0.65 0.65 0.65 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Warehouse Structural Layout -->
    <model name="warehouse_structure">
      <static>true</static>
      <link name="warehouse_link">

        <!-- Outer Boundary Walls (20m x 18m, 3.5m high, 0.25m thick) -->
        <!-- North Wall -->
        <collision name="wh_north_col">
          <pose>0 9.0 1.75 0 0 0</pose>
          <geometry><box><size>20.25 0.25 3.5</size></box></geometry>
        </collision>
        <visual name="wh_north_vis">
          <pose>0 9.0 1.75 0 0 0</pose>
          <geometry><box><size>20.25 0.25 3.5</size></box></geometry>
          <material><ambient>0.5 0.52 0.55 1</ambient><diffuse>0.55 0.57 0.6 1</diffuse></material>
        </visual>

        <!-- South Wall -->
        <collision name="wh_south_col">
          <pose>0 -9.0 1.75 0 0 0</pose>
          <geometry><box><size>20.25 0.25 3.5</size></box></geometry>
        </collision>
        <visual name="wh_south_vis">
          <pose>0 -9.0 1.75 0 0 0</pose>
          <geometry><box><size>20.25 0.25 3.5</size></box></geometry>
          <material><ambient>0.5 0.52 0.55 1</ambient><diffuse>0.55 0.57 0.6 1</diffuse></material>
        </visual>

        <!-- West Wall (Loading Bay Side) -->
        <collision name="wh_west_col">
          <pose>-10.0 0 1.75 0 0 0</pose>
          <geometry><box><size>0.25 18.25 3.5</size></box></geometry>
        </collision>
        <visual name="wh_west_vis">
          <pose>-10.0 0 1.75 0 0 0</pose>
          <geometry><box><size>0.25 18.25 3.5</size></box></geometry>
          <material><ambient>0.5 0.52 0.55 1</ambient><diffuse>0.55 0.57 0.6 1</diffuse></material>
        </visual>

        <!-- East Wall -->
        <collision name="wh_east_col">
          <pose>10.0 0 1.75 0 0 0</pose>
          <geometry><box><size>0.25 18.25 3.5</size></box></geometry>
        </collision>
        <visual name="wh_east_vis">
          <pose>10.0 0 1.75 0 0 0</pose>
          <geometry><box><size>0.25 18.25 3.5</size></box></geometry>
          <material><ambient>0.5 0.52 0.55 1</ambient><diffuse>0.55 0.57 0.6 1</diffuse></material>
        </visual>

        <!-- Support Concrete Columns (0.6m x 0.6m, 3.5m high) -->
        <collision name="col_1">
          <pose>-4.0 4.5 1.75 0 0 0</pose>
          <geometry><box><size>0.6 0.6 3.5</size></box></geometry>
        </collision>
        <visual name="col_1_v">
          <pose>-4.0 4.5 1.75 0 0 0</pose>
          <geometry><box><size>0.6 0.6 3.5</size></box></geometry>
          <material><ambient>0.8 0.7 0.2 1</ambient><diffuse>0.9 0.75 0.2 1</diffuse></material>
        </visual>

        <collision name="col_2">
          <pose>-4.0 -4.5 1.75 0 0 0</pose>
          <geometry><box><size>0.6 0.6 3.5</size></box></geometry>
        </collision>
        <visual name="col_2_v">
          <pose>-4.0 -4.5 1.75 0 0 0</pose>
          <geometry><box><size>0.6 0.6 3.5</size></box></geometry>
          <material><ambient>0.8 0.7 0.2 1</ambient><diffuse>0.9 0.75 0.2 1</diffuse></material>
        </visual>

        <collision name="col_3">
          <pose>4.0 4.5 1.75 0 0 0</pose>
          <geometry><box><size>0.6 0.6 3.5</size></box></geometry>
        </collision>
        <visual name="col_3_v">
          <pose>4.0 4.5 1.75 0 0 0</pose>
          <geometry><box><size>0.6 0.6 3.5</size></box></geometry>
          <material><ambient>0.8 0.7 0.2 1</ambient><diffuse>0.9 0.75 0.2 1</diffuse></material>
        </visual>

        <collision name="col_4">
          <pose>4.0 -4.5 1.75 0 0 0</pose>
          <geometry><box><size>0.6 0.6 3.5</size></box></geometry>
        </collision>
        <visual name="col_4_v">
          <pose>4.0 -4.5 1.75 0 0 0</pose>
          <geometry><box><size>0.6 0.6 3.5</size></box></geometry>
          <material><ambient>0.8 0.7 0.2 1</ambient><diffuse>0.9 0.75 0.2 1</diffuse></material>
        </visual>

        <!-- INDUSTRIAL STORAGE RACKS (Running along Y, width 0.9m, length 10.0m, height 2.5m) -->
        <!-- Rack Row 1 (at x = -1.0) -->
        <collision name="rack_row_1_col">
          <pose>-1.0 0.0 1.25 0 0 0</pose>
          <geometry><box><size>0.9 10.0 2.5</size></box></geometry>
        </collision>
        <visual name="rack_row_1_vis">
          <pose>-1.0 0.0 1.25 0 0 0</pose>
          <geometry><box><size>0.9 10.0 2.5</size></box></geometry>
          <material><ambient>0.15 0.25 0.5 1</ambient><diffuse>0.2 0.35 0.65 1</diffuse></material>
        </visual>

        <!-- Rack Row 2 (at x = 2.0, Aisle width = 2.1m) -->
        <collision name="rack_row_2_col">
          <pose>2.0 0.0 1.25 0 0 0</pose>
          <geometry><box><size>0.9 10.0 2.5</size></box></geometry>
        </collision>
        <visual name="rack_row_2_vis">
          <pose>2.0 0.0 1.25 0 0 0</pose>
          <geometry><box><size>0.9 10.0 2.5</size></box></geometry>
          <material><ambient>0.15 0.25 0.5 1</ambient><diffuse>0.2 0.35 0.65 1</diffuse></material>
        </visual>

        <!-- Rack Row 3 (at x = 5.0, Aisle width = 2.1m) -->
        <collision name="rack_row_3_col">
          <pose>5.0 0.0 1.25 0 0 0</pose>
          <geometry><box><size>0.9 10.0 2.5</size></box></geometry>
        </collision>
        <visual name="rack_row_3_vis">
          <pose>5.0 0.0 1.25 0 0 0</pose>
          <geometry><box><size>0.9 10.0 2.5</size></box></geometry>
          <material><ambient>0.15 0.25 0.5 1</ambient><diffuse>0.2 0.35 0.65 1</diffuse></material>
        </visual>

        <!-- PALLET STACKS & CARGO STAGING -->
        <!-- Staging Area (West side, x around -7 to -5) -->
        <!-- Pallet Stack 1 -->
        <collision name="pallet_stack_1_col">
          <pose>-7.0 3.5 0.6 0 0 0</pose>
          <geometry><box><size>1.4 1.4 1.2</size></box></geometry>
        </collision>
        <visual name="pallet_stack_1_vis">
          <pose>-7.0 3.5 0.6 0 0 0</pose>
          <geometry><box><size>1.4 1.4 1.2</size></box></geometry>
          <material><ambient>0.6 0.45 0.25 1</ambient><diffuse>0.65 0.5 0.3 1</diffuse></material>
        </visual>

        <!-- Pallet Stack 2 -->
        <collision name="pallet_stack_2_col">
          <pose>-7.0 -3.5 0.6 0 0 0</pose>
          <geometry><box><size>1.4 1.4 1.2</size></box></geometry>
        </collision>
        <visual name="pallet_stack_2_vis">
          <pose>-7.0 -3.5 0.6 0 0 0</pose>
          <geometry><box><size>1.4 1.4 1.2</size></box></geometry>
          <material><ambient>0.6 0.45 0.25 1</ambient><diffuse>0.65 0.5 0.3 1</diffuse></material>
        </visual>

        <!-- Cargo Crates at East end (x around 8.0) -->
        <collision name="crate_stack_east_col">
          <pose>8.0 2.0 0.75 0 0 0</pose>
          <geometry><box><size>1.2 2.5 1.5</size></box></geometry>
        </collision>
        <visual name="crate_stack_east_vis">
          <pose>8.0 2.0 0.75 0 0 0</pose>
          <geometry><box><size>1.2 2.5 1.5</size></box></geometry>
          <material><ambient>0.5 0.35 0.2 1</ambient><diffuse>0.55 0.4 0.25 1</diffuse></material>
        </visual>

        <collision name="crate_stack_east_2_col">
          <pose>8.0 -3.0 0.5 0 0 0</pose>
          <geometry><box><size>1.2 2.0 1.0</size></box></geometry>
        </collision>
        <visual name="crate_stack_east_2_vis">
          <pose>8.0 -3.0 0.5 0 0 0</pose>
          <geometry><box><size>1.2 2.0 1.0</size></box></geometry>
          <material><ambient>0.5 0.35 0.2 1</ambient><diffuse>0.55 0.4 0.25 1</diffuse></material>
        </visual>

        <!-- Industrial Oil / Chemical Drums -->
        <collision name="drum_1_col">
          <pose>-1.0 6.5 0.5 0 0 0</pose>
          <geometry><cylinder><radius>0.35</radius><length>1.0</length></cylinder></geometry>
        </collision>
        <visual name="drum_1_vis">
          <pose>-1.0 6.5 0.5 0 0 0</pose>
          <geometry><cylinder><radius>0.35</radius><length>1.0</length></cylinder></geometry>
          <material><ambient>0.7 0.15 0.15 1</ambient><diffuse>0.8 0.2 0.2 1</diffuse></material>
        </visual>

        <collision name="drum_2_col">
          <pose>2.0 -6.5 0.5 0 0 0</pose>
          <geometry><cylinder><radius>0.35</radius><length>1.0</length></cylinder></geometry>
        </collision>
        <visual name="drum_2_vis">
          <pose>2.0 -6.5 0.5 0 0 0</pose>
          <geometry><cylinder><radius>0.35</radius><length>1.0</length></cylinder></geometry>
          <material><ambient>0.15 0.4 0.7 1</ambient><diffuse>0.2 0.5 0.8 1</diffuse></material>
        </visual>

      </link>
    </model>
  </world>
</sdf>
